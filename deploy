#!/usr/bin/env python3
"""
This script parses the filemap.yaml file and outputs the changes it
would make to the targets on the current system (default: DRYRUN=true).
"""

import sys
import os

from pylib import deploy_changes, preview_changes, parse_filemap

if len(sys.argv) > 1:
    items = parse_filemap(sys.argv[1])
else:
    items = parse_filemap()

if os.environ.get("DRYRUN") == "false":
    deploy_changes(items)
else:
    preview_changes(items)
